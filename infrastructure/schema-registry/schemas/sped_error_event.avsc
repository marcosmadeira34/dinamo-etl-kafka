{
  "type": "record",
  "name": "SpedErrorEvent",
  "namespace": "com.dinamo.sped.events",
  "doc": "Error envelope for DLQ and retry topics",
  "fields": [
    {"name": "original_topic", "type": "string"},
    {"name": "original_partition", "type": ["null", "int"], "default": null},
    {"name": "original_offset", "type": ["null", "long"], "default": null},
    {"name": "original_key", "type": ["null", "string"], "default": null},
    {"name": "original_value", "type": ["null", "string"], "default": null},
    {"name": "error_message", "type": "string"},
    {"name": "error_class", "type": ["null", "string"], "default": null},
    {"name": "consumer_group", "type": ["null", "string"], "default": null},
    {"name": "retry_count", "type": "int", "default": 0},
    {"name": "timestamp_ms", "type": "long"},
    {"name": "status", "type": "string", "default": "FAILED"}
  ]
}
